NODE_ENV=development
LOG_LEVEL=debug

# API
API_PORT=8000
API_BASE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
# Enable sign-ups for local development; set false to close public registration.
ALLOW_REGISTRATION=true

# Database (use "postgres" as host when running inside Docker Compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=atlasops
POSTGRES_USER=atlasops
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://atlasops:change-me-local-only@localhost:5432/atlasops

# Redis (rate-limit storage)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO / S3-compatible object storage (document files live here, separate from the text index)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=atlasops-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-local-only

# Redpanda / Kafka (document.uploaded events drive background ingestion)
KAFKA_BROKERS=localhost:19092
REDPANDA_BOOTSTRAP=localhost:19092
KAFKA_CLIENT_ID=atlasops-local

# JWT access-token signing secret (must be >= 32 random characters)
# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-here

# LLM / embedding providers (optional; semantic search uses local SentenceTransformer by default)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Rate limiting and uploads
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/hour
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_SEARCH=30/minute
MAX_UPLOAD_MB=25
