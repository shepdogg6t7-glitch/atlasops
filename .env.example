NODE_ENV=development
LOG_LEVEL=debug

API_PORT=8000
API_BASE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:3000
# Enable sign-ups for local development; set false to close public registration.
ALLOW_REGISTRATION=true

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=atlasops
POSTGRES_USER=atlasops
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://atlasops:change-me-local-only@postgres:5432/atlasops

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=atlasops-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-local-only

KAFKA_BROKERS=redpanda:9092
KAFKA_CLIENT_ID=atlasops-local

JWT_SECRET=

LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# LLM provider examples:
# LLM_PROVIDER=gemini
# LLM_API_KEY=your-gemini-api-key
# LLM_MODEL=gemini-1.5-flash
#
# LLM_PROVIDER=openai
# LLM_API_KEY=your-openai-api-key
# LLM_MODEL=gpt-4o-mini
#
# LLM_PROVIDER=anthropic
# LLM_API_KEY=your-anthropic-api-key
# LLM_MODEL=claude-3-haiku-20240307

# Optional fallback provider (used when the primary provider call fails):
# LLM_FALLBACK_PROVIDER=anthropic
# LLM_FALLBACK_API_KEY=your-anthropic-api-key
# LLM_FALLBACK_MODEL=claude-3-haiku-20240307

# API rate limiting and document uploads (all optional; defaults shown)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/hour
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_SEARCH=30/minute
RATE_LIMIT_ASK=20/minute
MAX_UPLOAD_MB=25
